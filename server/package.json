{
    "name": "server",
    "version": "1.0.0",
    "description": "A simple MERN API",
    "main": "server.js",
    "author": "Alpha",
    "license": "MIT",
    "dependencies": {
        "concurrently": "^7.1.0",
        "connect-redis": "^6.1.3",
        "cors": "^2.8.5",
        "dotenv": "^8.2.0",
        "express": "^4.17.1",
        "express-oauth2-jwt-bearer": "^1.9.1",
        "express-session": "^1.17.3",
        "helmet": "^8.3.0",
        "mongodb": "^4.5.0",
        "mongoose": "^5.11.15",
        "numeral": "^2.0.6",
        "redis": "^4.1.0",
        "slugify": "^1.4.6",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/node": "^18.19.0",
        "@types/supertest": "^7.2.1",
        "jest": "^30.4.2",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^2.0.7",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "^4.9.5"
    },
    "engines": {
        "node": ">=14.13.0"
    },
    "scripts": {
        "dev-client": "cd ../client && npm start",
        "dev": "concurrently -n 'server,client' \"nodemon --exec ts-node --ext ts,json server.ts\" \"npm run dev-client\"",
        "client": "npm run start --prefix ../client",
        "prestart": "npm run build --prefix ../client",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "NODE_ENV=test jest --runInBand",
        "test:watch": "NODE_ENV=test jest --runInBand --watch",
        "test:coverage": "NODE_ENV=test jest --runInBand --coverage"
    }
}
