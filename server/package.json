{
    "name": "server",
    "version": "1.0.0",
    "description": "A simple MERN API",
    "main": "server.js",
    "author": "Alpha",
    "license": "MIT",
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-oauth2-jwt-bearer": "^1.9.1",
        "helmet": "^8.3.0",
        "mongoose": "^8.24.4",
        "pino": "^9.14.0",
        "pino-http": "^10.5.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^30.0.0",
        "@types/node": "^18.19.0",
        "@types/supertest": "^7.2.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.9.1",
        "jest": "^30.5.0",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "^4.9.5",
        "typescript-eslint": "^8.68.0"
    },
    "engines": {
        "node": ">=14.13.0"
    },
    "scripts": {
        "dev-client": "cd ../client && npm start",
        "dev": "concurrently -n 'server,client' \"nodemon --exec ts-node --ext ts,json server.ts\" \"npm run dev-client\"",
        "client": "npm run start --prefix ../client",
        "prestart": "npm run build --prefix ../client",
        "build": "tsc",
        "lint": "eslint .",
        "start": "node dist/server.js",
        "test": "NODE_ENV=test jest --runInBand",
        "test:watch": "NODE_ENV=test jest --runInBand --watch",
        "test:coverage": "NODE_ENV=test jest --runInBand --coverage"
    }
}
