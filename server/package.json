{
    "name": "server",
    "version": "1.0.0",
    "description": "A simple MERN API",
    "overrides": {
        "qs": "^6.16.0"
    },
    "main": "server.js",
    "author": "Alpha",
    "license": "MIT",
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-oauth2-jwt-bearer": "^1.9.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "ioredis": "^6.0.0",
        "mongoose": "^9.9.5",
        "node-cron": "^4.6.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "web-push": "^3.6.7",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@types/body-parser": "^1.19.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/node": "^18.19.0",
        "@types/node-cron": "^3.0.11",
        "@types/supertest": "^7.2.1",
        "@types/web-push": "^3.6.4",
        "concurrently": "^10.0.5",
        "eslint": "^10.9.1",
        "jest": "^30.5.0",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.12",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev-client": "cd ../client && npm start",
        "dev": "concurrently -n 'server,client' \"nodemon --exec ts-node --ext ts,json server.ts\" \"npm run dev-client\"",
        "client": "npm run start --prefix ../client",
        "prestart": "npm run build --prefix ../client",
        "build": "tsc",
        "lint": "eslint .",
        "start": "node dist/server.js",
        "test": "NODE_ENV=test jest --runInBand",
        "test:watch": "NODE_ENV=test jest --runInBand --watch",
        "test:coverage": "NODE_ENV=test jest --runInBand --coverage",
        "migrate:tags:dry-run": "ts-node scripts/migrateTagsToSnapshot.ts --dry-run",
        "migrate:tags": "ts-node scripts/migrateTagsToSnapshot.ts",
        "cleanup:stat-selection:dry-run": "ts-node scripts/resetStaleTrackedStatSelection.ts --dry-run",
        "cleanup:stat-selection": "ts-node scripts/resetStaleTrackedStatSelection.ts"
    }
}
